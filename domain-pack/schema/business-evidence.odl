# Business facts and evidence added in definition revision 0.2.0.

type PersonProfile @objectType {
  id: ID! @primary
  sourceSystem: String!
  sourceRecordId: String!
  state: String!
  observedAt: DateTime!
  fieldsJson: String @sensitive
  fieldAvailabilityJson: String
  sourceVersion: String
}

type AuthorityGrant @objectType {
  id: ID! @primary
  permission: String!
  state: String!
  scopeKind: String!
  validFrom: DateTime!
  validTo: DateTime
}

type ClassificationMapping @objectType {
  id: ID! @primary
  kind: String!
  sourceCode: String!
  state: String!
  version: String!
  inherited: Boolean!
  priority: Int
  publishedAt: DateTime
}

type RuleVersion @objectType {
  id: ID! @primary
  version: String!
  state: String!
  conditionJson: String!
  fieldDependenciesJson: String!
  configurationDigest: String!
  createdAt: DateTime!
  publishedAt: DateTime
}

type RuleImpactPreview @objectType {
  id: ID! @primary
  inputDigest: String!
  scopeJson: String!
  addedCount: Int!
  expiredCount: Int!
  unchangedCount: Int!
  unknownCount: Int!
  createdAt: DateTime!
}

type AiPolicyVersion @objectType {
  id: ID! @primary
  version: String!
  state: String!
  promptTemplate: String!
  allowedFieldsJson: String!
  configurationDigest: String!
  createdAt: DateTime!
  publishedAt: DateTime
}

type TagEvaluation @objectType {
  id: ID! @primary
  state: String!
  inputDigest: String!
  evidenceJson: String @sensitive
  reason: String!
  evaluatedAt: DateTime!
}

type TagContribution @objectType {
  id: ID! @primary
  source: String!
  sourceReference: String!
  state: String!
  effectiveFrom: DateTime!
  effectiveTo: DateTime
  reason: String
  actorId: String
  organizationId: String
}

type SupervisionMatter @objectType {
  id: ID! @primary
  name: String!
  kind: String!
  state: String!
  sourceSystem: String
  sourceRecordId: String
  startedAt: DateTime
  endedAt: DateTime
}

type MatterStage @objectType {
  id: ID! @primary
  name: String!
  sequence: Int!
  state: String!
  startedAt: DateTime
  endedAt: DateTime
}

type MatterParticipation @objectType {
  id: ID! @primary
  role: String!
  state: String!
  responsibilities: String
  validFrom: DateTime!
  validTo: DateTime
}

type RecipientSelection @objectType {
  criteriaJson: String
  entriesJson: String
  id: ID! @primary
  state: String!
  organizationRootsJson: String!
  tagVersionIdsJson: String!
  tagOperator: String!
  criteriaDigest: String!
  revision: Int!
  confirmedDigest: String
  confirmedAt: DateTime
  confirmedBy: String
}

type SelectionEntry @objectType {
  id: ID! @primary
  state: String!
  matchedByCondition: Boolean!
  explicitlyIncluded: Boolean!
  manuallyExcluded: Boolean!
  exclusionReason: String
  sourceOrganizationId: String
  eligibilityDigest: String
  confirmedPersonVersion: Int
}

type ReviewRound @objectType {
  taskId: String @indexed
  versionId: String
  organizationId: String
  id: ID! @primary
  roundNumber: Int!
  state: String!
  submittedBy: String!
  submittedAt: DateTime!
  snapshotDigest: String!
  decidedBy: String
  decidedAt: DateTime
  comment: String
}

type ContentSafetyCheck @objectType {
  id: ID! @primary
  state: String!
  contentDigest: String!
  selectionDigest: String!
  mediaDigest: String!
  linksJson: String!
  duplicateRecipientCount: Int!
  previousSentAt: DateTime
  confirmedBy: String
  confirmedAt: DateTime
}

type MediaConfirmation @objectType {
  id: ID! @primary
  mediaDigest: String!
  confirmedBy: String!
  confirmedAt: DateTime!
  assertion: String!
}

type RecipientVersionState @objectType {
  id: ID! @primary
  state: String!
  firstReadAt: DateTime
  publishedAt: DateTime!
  updatedAt: DateTime!
}

type IntegrationIssue @objectType {
  id: ID! @primary
  category: String!
  state: String!
  reason: String!
  externalEventId: String
  occurredAt: DateTime!
  resolvedAt: DateTime
  resolution: String
  resolvedBy: String
}

type AssistantQuery @objectType {
  id: ID! @primary
  question: String!
  parsedConditionsJson: String!
  metricCodesJson: String!
  resultScopeJson: String!
  sourceReferencesJson: String!
  state: String!
  requestedAt: DateTime!
}

type AssistantActionCard @objectType {
  id: ID! @primary
  action: String!
  conditionsJson: String!
  state: String!
  createdAt: DateTime!
  expiresAt: DateTime!
  confirmedAt: DateTime
}


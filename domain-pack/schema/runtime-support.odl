# Technical support for existing application commands; not a government business domain.

type BusinessCommandReceipt @objectType {
  id: ID! @primary
  action: String!
  actorId: String!
  requestHash: String!
  responseJson: String!
}

type BusinessWriteLock @objectType {
  id: ID! @primary
  actorId: String!
}

# Technical current evaluation index; immutable evidence remains in TagEvaluation.
type RuleProcessingCursor @objectType {
  id: ID! @primary
  personId: String!
  ruleId: String!
  ruleVersionId: String!
  tagVersionId: String!
  inputDigest: String!
  evaluationId: String!
  evaluatedAt: DateTime!
}

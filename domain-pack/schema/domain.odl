extend schema @namespace(name: "gov.object-library", version: "0.2.3")

type Person @objectType {
  id: ID! @primary
  name: String! @indexed
  employeeNo: String @unique @indexed
  status: String!
  identityStatus: String!
  gender: String
  birthDate: Date
  joinedAt: Date
  rank: String
  managedCadre: Boolean
  identityReference: String @sensitive
  phoneReference: String @sensitive
  profileStatus: String
  sourceSystem: String
  sourceRecordId: String
  sourceObservedAt: DateTime
  sourceVersion: String
}

type Organization @objectType {
  id: ID! @primary
  name: String! @indexed
  organizationCode: String @unique @indexed
  nature: String!
  status: String!
  sourceSystem: String
  sourceRecordId: String
  managedUnit: Boolean
  responsibilityKind: String
  sourceVersion: String
  sourceObservedAt: DateTime
}

type Position @objectType {
  id: ID! @primary
  name: String! @indexed
  level: String
  domain: String
}

type Assignment @objectType {
  id: ID! @primary
  title: String!
  status: String!
  startedAt: DateTime
  endedAt: DateTime
  isPrincipal: Boolean
  responsibilities: String
  sourceReference: String
}

type ExternalIdentity @objectType {
  id: ID! @primary
  sourceSystem: String! @indexed
  sourceRecordId: String! @indexed
  status: String!
  observedAt: DateTime
  identityKind: String
  verifiedAt: DateTime
  verificationReference: String
}

type DataAssociationIssue @objectType {
  id: ID! @primary
  category: String! @indexed
  field: String
  reason: String!
  status: String!
  detectedAt: DateTime!
  resolvedAt: DateTime
  suggestedResolution: String
  sourceReference: String
  resolvedBy: String
  resolution: String
}

type ObjectEligibility @objectType {
  id: ID! @primary
  state: String! @indexed
  reason: String
  changedAt: DateTime!
}

type UserAccount @objectType {
  id: ID! @primary
  username: String! @unique @indexed
  state: String! @indexed
  personId: String @indexed
  changedAt: DateTime!
  sourceSystem: String
  sourceRecordId: String
  sourceVersion: String
  sourceObservedAt: DateTime
}

type TagDefinition @objectType {
  id: ID! @primary
  code: String! @unique @indexed
  name: String! @indexed
  scope: String!
  status: String!
  level: Int!
  parentId: String @indexed
  dimension: String!
  description: String
  currentVersionId: String
  assignmentMode: String
  aiEligible: Boolean
  reminderFocus: String
}

type TagVersion @objectType {
  id: ID! @primary
  tagDefinitionId: String! @indexed
  version: String!
  status: String!
  publishedAt: DateTime
  nameSnapshot: String
  descriptionSnapshot: String
  parentIdSnapshot: String
  dimensionSnapshot: String
  scopeSnapshot: String
  assignmentModeSnapshot: String
  reminderFocusSnapshot: String
  configurationDigest: String
}

type TagRule @objectType {
  id: ID! @primary
  tagDefinitionId: String! @indexed
  ruleType: String!
  expression: String!
  status: String!
  version: String!
  configurationVersion: String
  conditionJson: String
  fieldDependenciesJson: String
  recomputeSchedule: String
}

type PersonTagAssignment @objectType {
  id: ID! @primary
  state: String! @indexed
  source: String! @indexed
  sourceReference: String
  tagVersion: String!
  effectiveFrom: DateTime!
  effectiveTo: DateTime
  manualSuppressed: Boolean!
  note: String
  personId: String @indexed
  tagDefinitionId: String @indexed
  tagNameSnapshot: String
  operatorId: String
  sourceOrganizationId: String
  operatorOrganizationId: String
  suppressedAt: DateTime
  suppressedBy: String
  suppressionReason: String
}





type TagCandidate @objectType {
  id: ID! @primary
  state: String! @indexed
  source: String!
  reason: String!
  createdAt: DateTime!
  reviewedAt: DateTime
  reviewDecision: String
  reviewedBy: String
  reviewOrganizationId: String
  inputDigest: String
  assessmentVersion: String
}

type TagProcessingIssue @objectType {
  id: ID! @primary
  category: String! @indexed
  reason: String!
  field: String
  state: String!
  detectedAt: DateTime!
  suggestedResolution: String
  resolvedAt: DateTime
  resolution: String
}

type TagBatch @objectType {
  id: ID! @primary
  kind: String!
  state: String! @indexed
  startedAt: DateTime!
  finishedAt: DateTime
  successCount: Int!
  failureCount: Int!
  scopeSnapshotJson: String
  configurationDigest: String
  createdBy: String
  organizationId: String
  skippedCount: Int
  unknownCount: Int
}

type Project @objectType {
  id: ID! @primary
  name: String! @indexed
  phase: String!
  status: String!
}

type RiskEvent @objectType {
  id: ID! @primary
  category: String! @indexed
  severity: String!
  occurredAt: DateTime!
  state: String!
  description: String
  sourceSystem: String
  sourceRecordId: String
  observedAt: DateTime
  internalEvidenceReference: String @sensitive
}

type ReminderContent @objectType {
  currentVersionId: String
  id: ID! @primary
  title: String!
  category: String! @indexed
  state: String! @indexed
}

type ContentVersion @objectType {
  categorySnapshot: String
  contentDigest: String
  mediaManifestDigest: String
  id: ID! @primary
  contentId: String! @indexed
  version: String!
  title: String!
  body: String!
  state: String!
  createdAt: DateTime!
}

type MediaAsset @objectType {
  organizationId: String
  id: ID! @primary
  mediaType: String!
  storageKey: String!
  state: String!
  createdAt: DateTime!
  mimeType: String
  sizeBytes: Int
  contentHash: String
  width: Int
  height: Int
  uploadedBy: String
}

type ReminderTask @objectType {
  id: ID! @primary
  state: String! @indexed
  sendMode: String!
  plannedAt: DateTime
  readingWindow: String!
  createdAt: DateTime!
  title: String
  bodyHtml: String
  personIdsJson: String
  createdBy: String @indexed
  organizationId: String @indexed
  reviewRound: Int
  submittedBy: String
  snapshotId: String
  reviewedBy: String
  reviewComment: String
  selectionId: String
  draftSequence: Int
  contentCheckId: String
  activeReviewId: String
  cancelReason: String
  revisionState: String
  currentPublishedVersionId: String
  pendingVersionId: String
  categorySnapshot: String
}

type ReminderTaskVersion @objectType {
  id: ID! @primary
  taskId: String! @indexed
  version: String!
  state: String!
  titleSnapshot: String!
  bodySnapshot: String!
  readingWindow: String!
  publishedAt: DateTime
  recipientsJson: String
  snapshotHash: String
  sendMode: String
  plannedAt: DateTime
  submittedAt: DateTime
  basePublishedVersionId: String
  versionKind: String
  sourceContentVersionId: String
  linksSnapshotJson: String
  mediaManifestDigest: String
  selectionDigest: String
  selectionSnapshotJson: String
  scopeSnapshotJson: String
  contentDigest: String
  categorySnapshot: String
}

type ReminderSendJob @objectType {
  id: ID! @primary
  taskId: String! @indexed
  snapshotId: String!
  state: String! @indexed
  dueAt: DateTime!
  createdAt: DateTime!
  leaseOwner: String
  leaseUntil: DateTime
  recipientIdsJson: String
}

type RecipientRecord @objectType {
  id: ID! @primary
  taskVersionId: String @indexed
  personId: String! @indexed
  state: String @indexed
  sentAt: DateTime
  deadlineAt: DateTime
  personNameSnapshot: String
  organizationIdSnapshot: String
  organizationNameSnapshot: String
  readingWindow: String
  taskId: String! @indexed
  firstDeliveredAt: DateTime
  deliveryState: String
  withdrawalState: String
  selectionSource: String
  eligibilitySnapshotJson: String
  channelMode: String
  latestAttemptId: String
}

type DeliveryAttempt @objectType {
  id: ID! @primary
  recipientId: String! @indexed
  state: String!
  attemptedAt: DateTime!
  errorCode: String
  attemptKey: String
  submittedAt: DateTime
  externalRequestId: String
  resultObservedAt: DateTime
  taskVersionId: String
  channelMode: String
  identityReference: String @sensitive
}

type DeliveryReceipt @objectType {
  id: ID! @primary
  recipientId: String! @indexed
  state: String!
  receivedAt: DateTime!
  externalId: String
  externalEventId: String
  occurredAt: DateTime
  attemptId: String
  errorCode: String
  channelMode: String
}

type ReadReceipt @objectType {
  id: ID! @primary
  recipientId: String! @indexed
  taskVersionId: String! @indexed
  readAt: DateTime!
  eventKey: String
  recordedAt: DateTime
  identityEvidenceReference: String
}

type OverdueRecord @objectType {
  id: ID! @primary
  recipientId: String! @indexed
  state: String!
  createdAt: DateTime!
  resolvedAt: DateTime
  taskVersionId: String
  supervisorOrganizationId: String
  closedReason: String
}

type WithdrawalRecord @objectType {
  id: ID! @primary
  recipientId: String! @indexed
  state: String!
  reason: String
  requestedAt: DateTime!
  completedAt: DateTime
  requestedBy: String
  organizationId: String
  requestKey: String
  externalRequestId: String
  errorCode: String
}

type PersonBelongsToOrganization @linkType(from: "Person", to: "Organization", cardinality: MANY_TO_ONE) {
  id: ID! @primary
  startedAt: DateTime!
  endedAt: DateTime
}

type PersonHoldsPosition @linkType(from: "Person", to: "Position", cardinality: MANY_TO_MANY) {
  id: ID! @primary
  startedAt: DateTime!
  endedAt: DateTime
}

type PersonHasAssignment @linkType(from: "Person", to: "Assignment", cardinality: ONE_TO_MANY) {
  id: ID! @primary
  startedAt: DateTime!
  endedAt: DateTime
}

type AssignmentInOrganization @linkType(from: "Assignment", to: "Organization", cardinality: MANY_TO_ONE) {
  id: ID! @primary
  startedAt: DateTime!
  endedAt: DateTime
}

type AssignmentOnProject @linkType(from: "Assignment", to: "Project", cardinality: MANY_TO_MANY) {
  id: ID! @primary
  role: String
}

type ExternalIdentityForPerson @linkType(from: "ExternalIdentity", to: "Person", cardinality: MANY_TO_ONE) {
  id: ID! @primary
  linkedAt: DateTime!
}

type IssueForPerson @linkType(from: "DataAssociationIssue", to: "Person", cardinality: MANY_TO_ONE) {
  id: ID! @primary
  linkedAt: DateTime!
}

type EligibilityForPerson @linkType(from: "ObjectEligibility", to: "Person", cardinality: MANY_TO_ONE) {
  id: ID! @primary
  linkedAt: DateTime!
}

type AccountForPerson @linkType(from: "UserAccount", to: "Person", cardinality: MANY_TO_ONE) {
  id: ID! @primary
  linkedAt: DateTime!
}

type OrganizationParent @linkType(from: "Organization", to: "Organization", cardinality: MANY_TO_ONE) {
  id: ID! @primary
  relation: String!
  startedAt: DateTime!
  endedAt: DateTime
}

type PersonHasTag @linkType(from: "Person", to: "PersonTagAssignment", cardinality: ONE_TO_MANY) {
  id: ID! @primary
  linkedAt: DateTime!
}

type TagAssignmentUsesDefinition @linkType(from: "PersonTagAssignment", to: "TagDefinition", cardinality: MANY_TO_ONE) {
  id: ID! @primary
}

type TagCandidateForPerson @linkType(from: "TagCandidate", to: "Person", cardinality: MANY_TO_ONE) {
  id: ID! @primary
}

type IssueForTag @linkType(from: "TagProcessingIssue", to: "PersonTagAssignment", cardinality: MANY_TO_ONE) {
  id: ID! @primary
}

type BatchAffectsTag @linkType(from: "TagBatch", to: "PersonTagAssignment", cardinality: MANY_TO_MANY) {
  id: ID! @primary
}

type ContentHasVersion @linkType(from: "ReminderContent", to: "ContentVersion", cardinality: ONE_TO_MANY) {
  id: ID! @primary
}

type ContentSuggestsTag @linkType(from: "ReminderContent", to: "TagDefinition", cardinality: MANY_TO_MANY) {
  id: ID! @primary
}

type VersionUsesMedia @linkType(from: "ContentVersion", to: "MediaAsset", cardinality: MANY_TO_MANY) {
  id: ID! @primary
}

type TaskHasVersion @linkType(from: "ReminderTask", to: "ReminderTaskVersion", cardinality: ONE_TO_MANY) {
  id: ID! @primary
}

type VersionTargetsRecipient @linkType(from: "ReminderTaskVersion", to: "RecipientRecord", cardinality: MANY_TO_MANY) {
  id: ID! @primary
}

type RecipientHasDeliveryAttempt @linkType(from: "RecipientRecord", to: "DeliveryAttempt", cardinality: ONE_TO_MANY) {
  id: ID! @primary
}

type RecipientHasDeliveryReceipt @linkType(from: "RecipientRecord", to: "DeliveryReceipt", cardinality: ONE_TO_MANY) {
  id: ID! @primary
}

type RecipientHasReadReceipt @linkType(from: "RecipientRecord", to: "ReadReceipt", cardinality: ONE_TO_MANY) {
  id: ID! @primary
}

type RecipientHasOverdueRecord @linkType(from: "RecipientRecord", to: "OverdueRecord", cardinality: ONE_TO_MANY) {
  id: ID! @primary
}

type RecipientHasWithdrawal @linkType(from: "RecipientRecord", to: "WithdrawalRecord", cardinality: ONE_TO_MANY) {
  id: ID! @primary
}

type RiskInvolvesPerson @linkType(from: "RiskEvent", to: "Person", cardinality: MANY_TO_MANY) {
  id: ID! @primary
  source: String
  role: String
}
